+#[tokio::test(flavor="multi_thread",worker_threads=4)]
+async fn historical_delayed_settings_and_absent_settings() {
+    for (delay, expected_headers) in [(2,true),(14,false)] {
+        let fixture=Fixture::start_with_delays(32,Duration::from_secs(delay),Duration::ZERO).await;
+        let mut backend=fixture.backend();
+        let client=Client::new(&fixture.config(),backend.bridge.clone()).unwrap();
+        let start=std::time::Instant::now();
+        let result=client.open("127.0.0.1",7,true).await;
+        let elapsed=start.elapsed();
+        println!("SETTINGS delay={delay}s elapsed={elapsed:?} headers={:?}",fixture.request_ids(0));
+        assert_eq!(fixture.request_ids(0).len(),usize::from(expected_headers));
+        if expected_headers {
+            assert!(elapsed>=Duration::from_secs(2) && elapsed<Duration::from_secs(6));
+            let mut opened=result.unwrap();
+            echo(&mut opened.stream,&[0,4,0,b'o',b'k',b'!']).await;
+        } else {
+            let err=result.err().unwrap();
+            println!("SETTINGS error={err:#}");
+            assert!(elapsed>=Duration::from_secs(9) && elapsed<Duration::from_secs(13));
+            assert!(format!("{err:#}").contains("Extended CONNECT"));
+            // A plain TCP CONNECT on this same session still reaches the peer.
+            let mut opened=client.open("127.0.0.1",7,false).await.unwrap();
+            echo(&mut opened.stream,b"recovered after settings deadline").await;
+            assert_eq!(fixture.connection_count(),1);
+        }
+        drop(client); backend.shutdown().await; assert_eq!(backend.resource_count(),0);
+    }
+}
+#[tokio::test(flavor="multi_thread",worker_threads=4)]
+async fn historical_missing_response() {
+    let fixture=Fixture::start_with_delays(32, Duration::ZERO, Duration::from_secs(26)).await;
+    let mut backend=fixture.backend();
+    let client=Client::new(&fixture.config(),backend.bridge.clone()).unwrap();
+    let start=std::time::Instant::now();
+    let err=client.open("127.0.0.1",7,false).await.err().unwrap();
+    println!("RESPONSE elapsed={:?} headers={:?} error={err:#}",start.elapsed(),fixture.request_ids(0));
+    assert!(start.elapsed()>=Duration::from_secs(19) && start.elapsed()<Duration::from_secs(24));
+    assert!(format!("{err:#}").contains("no HTTP/3 response"));
+    assert_eq!(fixture.request_ids(0),[0]);
+    drop(client); backend.shutdown().await; assert_eq!(backend.resource_count(),0);
+}
