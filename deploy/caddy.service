# Caddy with the network_relay plugin. Based on Caddy's official unit
# (https://github.com/caddyserver/dist/blob/master/init/caddy.service).
#
# Installed by deploy/install.sh as /etc/systemd/system/caddy.service.

[Unit]
Description=Caddy with network_relay
Documentation=https://caddyserver.com/docs/
After=network.target network-online.target
Requires=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
# The default admin API can replace relay authentication and routing. Restrict
# local administration to this service account and root, including reloads.
RuntimeDirectory=caddy
RuntimeDirectoryMode=0700
Environment=CADDY_ADMIN=unix//run/caddy/admin.sock
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile
# Reloads keep open tunnels, except those of removed users.
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile --force
TimeoutStopSec=5s
# One file per relayed connection.
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=full
AmbientCapabilities=CAP_NET_BIND_SERVICE
# UDP over HTTP/2 needs extended CONNECT. The plugin turns it on itself
# when built by install.sh; this covers binaries built differently.
Environment=GODEBUG=http2xconnect=1

[Install]
WantedBy=multi-user.target
